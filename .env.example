# Copy to .env (git-ignored). NEVER commit real values.

# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/contacttinder

# Google OAuth (People API, read-only contacts scope)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/accounts/callback

# Token encryption — a urlsafe base64 32-byte Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Import behavior
IMPORT_MAX_ATTEMPTS=5
IMPORT_PAGE_SIZE=1000

# Google write path (features 003 delete + 004 export label). Default is the Google-free fake client
# used by CI/dev; set to `google` only on the worker to write to real Google. Labeling reuses the
# SAME contacts write scope as delete — NO new OAuth scope (research D1).
PEOPLE_WRITE_CLIENT=fake
# Name of the Google contact group applied by the export so the operator can filter & re-check.
PROCESS_LABEL_NAME=Process
